{
  "expo": {
    "name": "E-Marker",
    "slug": "mobile",
    "scheme": "com.emarker.app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/icon.png"
      },
      "config": {
        "googleSignIn": {
          "certificateHash": "11:E8:15:28:B4:10:05:C9:DC:80:F2:CD:01:88:84:8B:5D:98:B5:1A"
        }
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.emarker.app"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "microphonePermission": "Allow E-Marker to access the microphone while recording exam pages.",
          "recordAudioAndroid": true
        }
      ],
      "expo-web-browser",
      "expo-secure-store"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "ca320356-a9c8-412b-a805-5479dcce55a1"
      }
    },
    "owner": "ajugbo"
  }
}
